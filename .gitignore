# Gradle
.gradle/
build/
out/

# Stonecutter (マルチバージョンビルドの生成物)
versions/*/build/
versions/*/.gradle/
.stonecutter/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Runtime
run/

# OS
.DS_Store
Thumbs.db

# Logs / crash dumps
*.log
hs_err_pid*
replay_pid*
*.hprof
# Modrinth アップロード用のステージング置き場。
# jar を含むためコミットしない。
Modrinth-Versions/

# ============================================================
# 認証情報（絶対にコミットしない）
# ============================================================
# このクライアント Mod 自身は資格情報を一切書き出さないが、
# 開発中に run/ の外へ置いたトークンや鍵を取り込まないための保険として残す。
# （HikariScoreBoard 側の .gitignore と同じパターンを揃えてある）
.env
.env.*
secrets.properties
*.token
*.pem
*.key
*.jks
*.keystore
