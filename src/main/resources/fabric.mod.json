{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Client-side utility tweaks developed at Hikari Server (https://hikariserver.com). Custom scoreboard HUD (works with HikariScoreBoard), auto-restock, durability warning, and more.\n\nIDEA: AtsukiGames, Raiy256",
  "authors": [
    "Tamago0314"
  ],
  "contact": {
    "homepage": "https://hikariserver.com",
    "sources": "https://github.com/Tamago0314/Hikari-Tweaks",
    "issues": "https://github.com/Tamago0314/Hikari-Tweaks/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/hikari-tweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.hikariserver.hikaritweaks.HikariTweaksClient"
    ],
    "modmenu": [
      "com.hikariserver.hikaritweaks.integration.ModMenuCompat"
    ]
  },
  "mixins": [
    "hikari-tweaks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "malilib": "*"
  },
  "suggests": {
    "modmenu": "*",
    "minihud": "*"
  }
}